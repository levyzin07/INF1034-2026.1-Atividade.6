from pygame import *

# import sys

init()

window = display.set_mode((1280, 720))
running = True
clock = time.Clock()

gato_mingau = image.load("gato_mingau.jpg")
gato_mingau = transform.scale(gato_mingau, (200, 200))

gato_font = font.Font("fonte.ttf", 50)

# mixer.music.load("lo-siento-wilson-naufrago.mp3")
# mixer.music.play(-1)

#Definição de variáveis
a = 0
pos_x = 800
pos_sol = 0
pos_sol1 = 0
pos_sol2 = 0
estado = 0
cor_fundo = "#34ebeb"

while running:
    clock.tick(60)

    for ev in event.get():
        if ev.type == QUIT:
            running = False

        #Ações instantaneas
        if ev.type == KEYDOWN:
            key_pressed = ev.key
            if key_pressed == K_SPACE:
                estado = estado + 1
            elif estado%2 == 0:
                estado = 0
        

    #Update
    dt = clock.get_time()/1000
    keys = key.get_pressed()

    mouse_x, mouse_y = mouse.get_pos()

    #Se eu pressionar a tecla D ou A, então o sol:
    if estado == 0 or estado %2 == 0:
        if keys[K_d]:
            pos_sol = pos_sol + 100 * dt
        elif keys[K_a]:
            pos_sol = pos_sol - 100 * dt
    elif estado == 1:
        mouse_x, mouse_y = mouse.get_pos()
        pos_sol1 = mouse_x
        pos_sol2 = mouse_y

    if pos_sol > 800:
        cor_fundo = (219, 154, 15)
    elif pos_sol > 500:
        cor_fundo = (217, 164, 52)
    elif pos_sol > 300:
        cor_fundo = (237, 193, 100)
    else:
        cor_fundo = (151, 209, 250)

    #Nuvem anda automático
    if a == 0:
        pos_x = pos_x + 100 * dt
    else:
        pos_x = pos_x - 100 * dt
    #Nuvem bate e volta
    if pos_x > 1150:
        a = 1
    elif pos_x < 50:
        a = 0

    #Desenhar a partir daqui
    
    window.fill(cor_fundo)

    draw.rect(window, (201, 174, 149), (350, 290, 300, 300))
    draw.rect(window, (89, 42, 13), (500, 420, 90, 170))
    draw.rect(window, (5, 171, 242), (380, 420, 90, 90))
    draw.circle(window, (14, 15, 15), (520, 500), 10)
    draw.polygon(window, (161, 32, 6), ((350, 290), (500, 180), (650, 290)))
    
    draw.circle(window, (255, 243, 81), (mouse_x, mouse_y), 60)
    draw.line(window, (255, 243, 81), (200, 130), (200, 250), 5)
    draw.line(window, (255, 243, 81), (200, 130), (200, 10), 5)
    draw.line(window, (255, 243, 81), (200, 130), (320, 130), 5)
    draw.line(window, (255, 243, 81), (200, 130), (80, 130), 5)
    draw.line(window, (255, 243, 81), (200, 130), (260, 70), 5)
    draw.line(window, (255, 243, 81), (200, 130), (260, 190), 5)
    draw.line(window, (255, 243, 81), (200, 130), (140, 70), 5)
    draw.line(window, (255, 243, 81), (200, 130), (140, 190), 5)

    draw.rect(window, (71, 38, 7), (800, 390, 90, 200))
    draw.circle(window, (8, 94, 8), (845, 350), 100)

    draw.circle(window, (250, 250, 250), (pos_x, 100), 50)
    draw.circle(window, (250, 250, 250), (pos_x + 50, 100), 50)
    draw.circle(window, (250, 250, 250), (pos_x + 100, 100), 50)

    draw.rect(window, (52, 235, 58), (0, 590, 1280, 130))
    
    #Desenhar gato do mingau

    window.blit(gato_mingau, (900, 400))

    #Desenhar texto

    gato_text = gato_font.render("Wilson ama mingau", True, (0, 0, 0))
    window.blit(gato_text, (800, 600))

    display.update()
